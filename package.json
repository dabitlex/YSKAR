{
  "name": "yskar-node-core-app",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "YSKAR Node Core native Windows desktop application",
  "main": "src/electron-main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "app.yskar.nodecore",
    "productName": "YSKAR Node Core",
    "artifactName": "YSKAR-Node-Core-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/electron-main.mjs",
      "dist/node-core.cjs"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YSKAR Node Core",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true
  }
}

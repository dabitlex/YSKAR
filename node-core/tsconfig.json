{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "baseUrl": ".",
    "paths": { "*": ["./node_modules/*", "../node_modules/*"] }
  },
  "include": ["src/**/*.ts"]
}

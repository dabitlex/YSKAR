[Unit]
Description=YSKAR mirror catch-up — push blocks the mirror is missing
Documentation=https://github.com/dabitlex/YSKAR

After=network-online.target
Wants=network-online.target

# Without a running node there is nothing to push that could not be pushed
# later. No "Requires" -- a node that is down should not mark this service
# as failed.
After=yskar-node.service

[Service]
Type=oneshot
User=yskar
Group=yskar
WorkingDirectory=/home/yskar/YSKAR/node

EnvironmentFile=-/etc/yskar/node.env

# The same path to node as in yskar-node.service. If it changes there, it
# changes here too.
ExecStart=/usr/bin/node dist/yskar-node.cjs spiegel \
    --data ./knoten \
    --api https://yskar.vercel.app

# The running node keeps the same SQLite store open. That works because the
# store runs in WAL mode and this command only READS blocks. If it does get
# stuck once, this run fails -- and the next timer run makes up for it.
# Hence no Restart: repeating is the job of the timer.
TimeoutStartSec=1800

StandardOutput=journal
StandardError=journal
SyslogIdentifier=yskar-spiegel

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/yskar/YSKAR/node/knoten
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

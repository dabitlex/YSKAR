[Unit]
Description=YSKAR Spiegel nachziehen — liegengebliebene Blöcke nach Supabase schieben
Documentation=https://github.com/dabitlex/YSKAR

After=network-online.target
Wants=network-online.target

# Ohne laufenden Knoten ist nichts nachzuschieben, was nicht auch später
# ginge. Kein "Requires" -- ein ausgefallener Knoten soll diesen Dienst
# nicht als Fehler markieren.
After=yskar-node.service

[Service]
Type=oneshot
User=cointastig
Group=cointastig
WorkingDirectory=/home/cointastig/YSKAR/node

EnvironmentFile=-/etc/yskar/node.env

# Derselbe node-Pfad wie in yskar-node.service. Ändert sich der dort,
# ändert er sich auch hier.
ExecStart=/usr/bin/node dist/yskar-node.cjs spiegel \
    --data ./knoten \
    --api https://yskar.vercel.app

# Der laufende Knoten hält dieselbe SQLite-Ablage offen. Das geht, weil sie
# im WAL-Modus läuft und dieser Befehl nur LIEST. Sollte es doch einmal
# klemmen, scheitert dieser Lauf -- und der nächste Timer-Lauf holt es
# nach. Deshalb kein Restart: Wiederholen ist die Aufgabe des Timers.
TimeoutStartSec=1800

StandardOutput=journal
StandardError=journal
SyslogIdentifier=yskar-spiegel

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/cointastig/YSKAR/node/knoten
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

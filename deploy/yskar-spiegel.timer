[Unit]
Description=YSKAR mirror catch-up at regular intervals
Documentation=https://github.com/dabitlex/YSKAR

[Timer]
# The running node pushes every block it accepts to the mirror at once.
# This timer is the safety net below that: for every block where the push
# failed -- web server briefly away, node restarted, connection dropped.
#
# The mirror accepts only the NEXT block, so a single lost block stops all
# that follow.
#
# Every 5 minutes. A run with nothing to push costs almost nothing -- one
# HTTP request and a comparison of two numbers. In return a gap closes
# sooner, and that matters: the wallet in the app reads balances and
# history from the mirror, not from the node. If the mirror stands still,
# so do those numbers.
OnBootSec=2min
OnUnitActiveSec=5min

# Do not let all timers on the machine start at the same moment.
RandomizedDelaySec=60

# Persistent= only has an effect on timers with OnCalendar= (see
# systemd.timer). This timer has none, so the line changes nothing; after
# a boot the first run comes from OnBootSec above.
Persistent=true

Unit=yskar-spiegel.service

[Install]
WantedBy=timers.target

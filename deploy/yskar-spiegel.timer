[Unit]
Description=YSKAR Spiegel regelmäßig nachziehen
Documentation=https://github.com/dabitlex/YSKAR

[Timer]
# Der laufende Knoten schiebt jeden selbst gefundenen Block sofort hoch.
# Dieser Timer ist das Netz darunter: Für jeden Block, bei dem das einmal
# nicht geklappt hat -- Gegenstelle kurz weg, Knoten neu gestartet,
# Internet gestolpert.
#
# Das ist nicht hypothetisch: Genau so ist der Spiegel im September stehen
# geblieben. Und weil die Gegenstelle immer nur den NÄCHSTEN Block annimmt,
# blockiert ein einziger verlorener Block alle folgenden.
#
# Alle 5 Minuten. Ein Lauf ohne Rückstand kostet fast nichts -- ein
# HTTP-Request und ein Zahlenvergleich. Dafür schließt sich eine Lücke
# schneller, und das zählt: Die Wallet in der Mini App liest ihre Zahlen
# aus dem Spiegel, nicht aus dem Knoten. Steht der Spiegel, stehen ihre
# Zahlen.
OnBootSec=2min
OnUnitActiveSec=5min

# Nicht alle Timer auf dem Pi gleichzeitig loslaufen lassen.
RandomizedDelaySec=60

# Lief der Pi nicht, den ausgefallenen Lauf beim Start nachholen.
Persistent=true

Unit=yskar-spiegel.service

[Install]
WantedBy=timers.target

[Unit]
Description=YSKAR full node — validates the chain and runs the pool
Documentation=https://github.com/dabitlex/YSKAR

# network-online, not just network: at start the node talks to the mirror
# and to its peers. "network.target" is reached as soon as the network is
# being CONFIGURED -- not as soon as it is usable.
After=network-online.target
Wants=network-online.target

# If the node keeps failing at start (wrong path to node, broken store),
# systemd should not restart it forever. After five failed attempts within
# two minutes it stays down -- then something is broken that a restart
# does not fix, and "systemctl status" tells you.
# (Belongs in [Unit], not in [Service] -- there it is ignored.)
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=yskar
Group=yskar
WorkingDirectory=/home/yskar/YSKAR/node

# The token for the mirror is kept in a file of its own, not here. Unit
# files are readable for everyone; /etc/yskar/node.env belongs to root and
# has mode 600. The leading "-" means: if the file is missing, the service
# starts anyway -- then without a token, which works as long as the web
# server does not require one.
EnvironmentFile=-/etc/yskar/node.env

# CAUTION: absolute path to node. systemd has no PATH like your shell and
# no nvm. Check before you enable the unit:  which node
# If node is somewhere else (for example under
# ~/.nvm/versions/node/v22.x/bin/node), enter that path here. Node 22.13 or
# newer is required -- the node uses node:sqlite, which older versions do
# not have.
#
# This is the start command of the MAIN NODE: no --seed, no --no-upstream,
# and the public pool with its fee (100 basis points = 1 %) and the address
# the fee is paid to. Every other node is started with both seeds and
# --no-upstream instead, and a pool of your own needs your own name and
# your own payout address -- see deploy/README.md.
ExecStart=/usr/bin/node dist/yskar-node.cjs mine \
    --data ./knoten \
    --bind 127.0.0.1 \
    --port 8645 \
    --p2p-port 8646 \
    --pool yskar-main.dynv6.net \
    --pool-fee 100 \
    --pool-payout ysr1lfn8dw6st25jxv653vypcp929xs9lzg44954zz

# Always restart, not only on failure: a node that exits cleanly is just
# as gone for the chain as one that crashes.
Restart=always
RestartSec=10

# Stop cleanly: SIGINT instead of SIGTERM, so that the node closes its
# SQLite store in an orderly way.
KillSignal=SIGINT
TimeoutStopSec=30

# Output goes to the journal:  journalctl -u yskar-node -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yskar-node

# At most 80 % of one processor core. The node needs little; the limit
# keeps it below the load at which some hosters suspend a server, also
# while it loads the chain for the first time.
CPUQuota=80%

# --- Hardening ---
# The node needs its own directory (the store) and the network.
# Nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/yskar/YSKAR/node/knoten
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

# Vorlage für /etc/yskar/node.env
#
# Diese Datei enthält das Geheimnis. Sie gehört NICHT ins Repository --
# nur diese Vorlage. Auf dem Pi:
#
#   sudo mkdir -p /etc/yskar
#   sudo cp node.env.beispiel /etc/yskar/node.env
#   sudo nano /etc/yskar/node.env          # Wert eintragen
#   sudo chown root:root /etc/yskar/node.env
#   sudo chmod 600 /etc/yskar/node.env
#
# Wert erzeugen:  openssl rand -hex 32
#
# REIHENFOLGE BEIM EINSCHALTEN -- erst hier, dann in Vercel:
#
#   1. Diese Datei anlegen, Dienst neu starten.
#      Vercel verlangt den Token noch nicht und ignoriert ihn. Nichts
#      passiert -- und genau das ist gewollt.
#   2. Erst DANN in Vercel die Environment Variable YSKAR_SPIEGEL_TOKEN
#      auf denselben Wert setzen und neu deployen.
#
# Andersherum entsteht ein Fenster, in dem Vercel den Token schon verlangt
# und der Knoten noch keinen schickt. Jeder Block darin wird mit 401
# abgelehnt, und weil die Gegenstelle nur den nächsten Block annimmt,
# blockiert der erste abgelehnte alle folgenden.
#
# Ohne diese Datei läuft alles weiter -- dann nimmt die Gegenstelle Blöcke
# ohne Token an, wie vor dem Abschluss der Umstellung.

YSKAR_SPIEGEL_TOKEN=hier-den-wert-aus-openssl-rand-hex-32-eintragen

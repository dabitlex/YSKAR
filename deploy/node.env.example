# Template for /etc/yskar/node.env
#
# That file holds the secret. It does NOT belong in the repository --
# only this template does. On the machine of the main node:
#
#   sudo mkdir -p /etc/yskar
#   sudo cp node.env.example /etc/yskar/node.env
#   sudo nano /etc/yskar/node.env          # enter the value
#   sudo chown root:root /etc/yskar/node.env
#   sudo chmod 600 /etc/yskar/node.env
#
# Generate a value:  openssl rand -hex 32
#
# ORDER WHEN SWITCHING IT ON -- first here, then in Vercel:
#
#   1. Create this file, restart the service.
#      Vercel does not require the token yet and ignores it. Nothing
#      happens -- and that is exactly what is wanted.
#   2. Only THEN set the environment variable YSKAR_SPIEGEL_TOKEN to the
#      same value in Vercel and redeploy.
#
# The other way round there is a window in which Vercel already requires
# the token and the node does not send one yet. Every block in that window
# is rejected with 401, and because the mirror accepts only the next block,
# the first rejected block stops all that follow.
#
# Without this file everything keeps working as long as Vercel has no
# token set -- the mirror then accepts blocks without a token.

YSKAR_SPIEGEL_TOKEN=put-the-value-from-openssl-rand-hex-32-here

<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4x2: Guthaben, Bloecke, Mining-Zeile. Nur Elemente, die RemoteViews kennt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_hintergrund"
    android:paddingStart="18dp" android:paddingEnd="14dp"
    android:paddingTop="12dp" android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="22dp" android:layout_height="22dp"
            android:src="@mipmap/ic_launcher_foreground"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/app_name"
            android:textColor="#0E1A2F" android:textSize="12sp" android:textStyle="bold"
            android:letterSpacing="0.06" />
        <TextView
            android:id="@+id/w_stand"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8E9AB0" android:textSize="11sp" />
        <ImageView
            android:id="@+id/w_holen"
            android:layout_width="32dp" android:layout_height="32dp"
            android:padding="7dp"
            android:src="@drawable/ic_widget_holen"
            android:contentDescription="@string/widget_holen" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_guthaben"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#0E1A2F" android:textSize="24sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/w_bloecke"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#5B6B84" android:textSize="12.5sp"
        android:maxLines="1" android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/w_punkt"
            android:layout_width="8dp" android:layout_height="8dp"
            android:src="@drawable/widget_punkt"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/w_mining"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:textColor="#5B6B84" android:textSize="12.5sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      allowBackup="false": Der Tresor mit den verschluesselten Woertern liegt im
      WebView-Speicher. Mit Backup wanderte er ueber das Google-Konto auf ein
      anderes Geraet, ein Ort, den der Nutzer nicht kontrolliert.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          Mining-Dienst. Ein Vordergrunddienst mit dauerhafter Benachrichtigung
          haelt den Prozess am Leben und die CPU wach, wenn der Bildschirm aus
          ist. Der Typ specialUse ist der ehrliche: Es ist weder Datenabgleich
          noch Medienwiedergabe, sondern Rechenarbeit.
        -->
        <service
            android:name=".MiningService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Proof-of-Work-Mining, vom Nutzer gestartet und jederzeit ueber die Benachrichtigung stoppbar" />
        </service>

        <!-- Homescreen-Widget: die Mining-Uebersicht (Verdienst der Sitzung, Stopp). -->
        <receiver
            android:name=".YskarWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="net.yskar.wallet.WIDGET_HOLEN" />
                <action android:name="net.yskar.wallet.WIDGET_STOPP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR-Scan beim Senden (getUserMedia im WebView) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Push (Wallet-Eingang, News) und die Mining-Benachrichtigung -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Mining im Hintergrund -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Entsperren und Senden mit Fingerabdruck oder Gesicht -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Update aus der App heraus: die geladene APK dem Installer uebergeben. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>

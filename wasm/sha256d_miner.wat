    (local.set $tmp (i32.add (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))) (local.get $v1)))
    (i32.store offset=4 (local.get $sp) (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))))
    (local.set $tmp (i32.load offset=8 (local.get $sp)))
    (local.set $tmp (i32.add (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))) (local.get $v2)))
    (i32.store offset=8 (local.get $sp) (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))))
    (local.set $tmp (i32.load offset=12 (local.get $sp)))
    (local.set $tmp (i32.add (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))) (local.get $v3)))
    (i32.store offset=12 (local.get $sp) (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))))
    (local.set $tmp (i32.load offset=16 (local.get $sp)))
    (local.set $tmp (i32.add (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))) (local.get $v4)))
    (i32.store offset=16 (local.get $sp) (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))))
    (local.set $tmp (i32.load offset=20 (local.get $sp)))
    (local.set $tmp (i32.add (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))) (local.get $v5)))
    (i32.store offset=20 (local.get $sp) (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))))
    (local.set $tmp (i32.load offset=24 (local.get $sp)))
    (local.set $tmp (i32.add (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))) (local.get $v6)))
    (i32.store offset=24 (local.get $sp) (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))))
    (local.set $tmp (i32.load offset=28 (local.get $sp)))
    (local.set $tmp (i32.add (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))) (local.get $v7)))
    (i32.store offset=28 (local.get $sp) (i32.or (i32.and (i32.rotl (local.get $tmp) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $tmp) (i32.const 24)) (i32.const -16711936))))
  )
  ;; Bereitet einen Job vor: Midstate aus den ersten beiden Bloecken,
  ;; Block 3 mit Nonce-Platz und Padding, Block 4 fuer den zweiten Hash.
  (func $init_job (export "init_job")
    ;; IV nach 144 schreiben
    (i32.store offset=144 (i32.const 0) (i32.const 1743128938))
    (i32.store offset=148 (i32.const 0) (i32.const -2052167749))
    (i32.store offset=152 (i32.const 0) (i32.const 1928556092))
    (i32.store offset=156 (i32.const 0) (i32.const 989155237))
    (i32.store offset=160 (i32.const 0) (i32.const 2136084049))
    (i32.store offset=164 (i32.const 0) (i32.const -1939339877))
    (i32.store offset=168 (i32.const 0) (i32.const -1411808481))
    (i32.store offset=172 (i32.const 0) (i32.const 432922715))
    ;; Block 1 und Block 2 des Headers -- beide konstant je Job
    (call $compress (i32.const 144) (i32.const 0))
    (call $compress (i32.const 144) (i32.const 64))
    ;; Block 3: Header-Byte 128..136 (die Nonce) nach 176
    (i64.store offset=176 (i32.const 0) (i64.load offset=128 (i32.const 0)))
    ;; Padding: 0x80 direkt hinter der Nonce, dann Nullen
    (i64.store offset=184 (i32.const 0) (i64.const 0))
    (i64.store offset=192 (i32.const 0) (i64.const 0))
    (i64.store offset=200 (i32.const 0) (i64.const 0))
    (i64.store offset=208 (i32.const 0) (i64.const 0))
    (i64.store offset=216 (i32.const 0) (i64.const 0))
    (i64.store offset=224 (i32.const 0) (i64.const 0))
    (i64.store offset=232 (i32.const 0) (i64.const 0))
    (i32.store8 offset=184 (i32.const 0) (i32.const 128))
    ;; Laenge 136*8 = 1088 Bit, Big-Endian an Block-Offset 56
    (i32.store offset=236 (i32.const 0) (i32.const 1074003968))
    ;; Block 4: hash1 kommt spaeter nach 240, hier nur das Padding
    (i64.store offset=272 (i32.const 0) (i64.const 0))
    (i64.store offset=280 (i32.const 0) (i64.const 0))
    (i64.store offset=288 (i32.const 0) (i64.const 0))
    (i64.store offset=296 (i32.const 0) (i64.const 0))
    (i32.store8 offset=272 (i32.const 0) (i32.const 128))
    (i32.store offset=300 (i32.const 0) (i32.const 65536))
  )
  ;; Durchlaeuft $iters Nonces ab $start. Liefert 1, wenn ein Hash das
  ;; Target erfuellt (untere Haelfte der Nonce dann an Adresse 368).
  (func $mine (export "mine") (param $start i32) (param $iters i32) (result i32)
    (local $n i32) (local $i i32) (local $t1 i32) (local $t2 i32)
    (local.set $n (local.get $start))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $i) (local.get $iters)))
        ;; untere 32 Bit der Nonce; die oberen stehen fest im Block
        (i32.store offset=176 (i32.const 0) (local.get $n))
        ;; Midstate als Startzustand fuer Block 3
        (i64.store offset=240 (i32.const 0) (i64.load offset=144 (i32.const 0)))
        (i64.store offset=248 (i32.const 0) (i64.load offset=152 (i32.const 0)))
        (i64.store offset=256 (i32.const 0) (i64.load offset=160 (i32.const 0)))
        (i64.store offset=264 (i32.const 0) (i64.load offset=168 (i32.const 0)))
        (call $compress (i32.const 240) (i32.const 176))
        ;; zweiter SHA-256 ueber den ersten Digest
        (i32.store offset=304 (i32.const 0) (i32.const 1743128938))
        (i32.store offset=308 (i32.const 0) (i32.const -2052167749))
        (i32.store offset=312 (i32.const 0) (i32.const 1928556092))
        (i32.store offset=316 (i32.const 0) (i32.const 989155237))
        (i32.store offset=320 (i32.const 0) (i32.const 2136084049))
        (i32.store offset=324 (i32.const 0) (i32.const -1939339877))
        (i32.store offset=328 (i32.const 0) (i32.const -1411808481))
        (i32.store offset=332 (i32.const 0) (i32.const 432922715))
        (call $compress (i32.const 304) (i32.const 240))
        ;; hash <= target ? (byteweise Big-Endian)
        (block $nf
          (block $fd
            (local.set $t1 (i32.load offset=304 (i32.const 0)))
            (local.set $t1 (i32.or (i32.and (i32.rotl (local.get $t1) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t1) (i32.const 24)) (i32.const -16711936))))
            (local.set $t2 (i32.load offset=336 (i32.const 0)))
            (local.set $t2 (i32.or (i32.and (i32.rotl (local.get $t2) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t2) (i32.const 24)) (i32.const -16711936))))
            (br_if $fd (i32.lt_u (local.get $t1) (local.get $t2)))
            (br_if $nf (i32.gt_u (local.get $t1) (local.get $t2)))
            (local.set $t1 (i32.load offset=308 (i32.const 0)))
            (local.set $t1 (i32.or (i32.and (i32.rotl (local.get $t1) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t1) (i32.const 24)) (i32.const -16711936))))
            (local.set $t2 (i32.load offset=340 (i32.const 0)))
            (local.set $t2 (i32.or (i32.and (i32.rotl (local.get $t2) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t2) (i32.const 24)) (i32.const -16711936))))
            (br_if $fd (i32.lt_u (local.get $t1) (local.get $t2)))
            (br_if $nf (i32.gt_u (local.get $t1) (local.get $t2)))
            (local.set $t1 (i32.load offset=312 (i32.const 0)))
            (local.set $t1 (i32.or (i32.and (i32.rotl (local.get $t1) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t1) (i32.const 24)) (i32.const -16711936))))
            (local.set $t2 (i32.load offset=344 (i32.const 0)))
            (local.set $t2 (i32.or (i32.and (i32.rotl (local.get $t2) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t2) (i32.const 24)) (i32.const -16711936))))
            (br_if $fd (i32.lt_u (local.get $t1) (local.get $t2)))
            (br_if $nf (i32.gt_u (local.get $t1) (local.get $t2)))
            (local.set $t1 (i32.load offset=316 (i32.const 0)))
            (local.set $t1 (i32.or (i32.and (i32.rotl (local.get $t1) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t1) (i32.const 24)) (i32.const -16711936))))
            (local.set $t2 (i32.load offset=348 (i32.const 0)))
            (local.set $t2 (i32.or (i32.and (i32.rotl (local.get $t2) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t2) (i32.const 24)) (i32.const -16711936))))
            (br_if $fd (i32.lt_u (local.get $t1) (local.get $t2)))
            (br_if $nf (i32.gt_u (local.get $t1) (local.get $t2)))
            (local.set $t1 (i32.load offset=320 (i32.const 0)))
            (local.set $t1 (i32.or (i32.and (i32.rotl (local.get $t1) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t1) (i32.const 24)) (i32.const -16711936))))
            (local.set $t2 (i32.load offset=352 (i32.const 0)))
            (local.set $t2 (i32.or (i32.and (i32.rotl (local.get $t2) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t2) (i32.const 24)) (i32.const -16711936))))
            (br_if $fd (i32.lt_u (local.get $t1) (local.get $t2)))
            (br_if $nf (i32.gt_u (local.get $t1) (local.get $t2)))
            (local.set $t1 (i32.load offset=324 (i32.const 0)))
            (local.set $t1 (i32.or (i32.and (i32.rotl (local.get $t1) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t1) (i32.const 24)) (i32.const -16711936))))
            (local.set $t2 (i32.load offset=356 (i32.const 0)))
            (local.set $t2 (i32.or (i32.and (i32.rotl (local.get $t2) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t2) (i32.const 24)) (i32.const -16711936))))
            (br_if $fd (i32.lt_u (local.get $t1) (local.get $t2)))
            (br_if $nf (i32.gt_u (local.get $t1) (local.get $t2)))
            (local.set $t1 (i32.load offset=328 (i32.const 0)))
            (local.set $t1 (i32.or (i32.and (i32.rotl (local.get $t1) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t1) (i32.const 24)) (i32.const -16711936))))
            (local.set $t2 (i32.load offset=360 (i32.const 0)))
            (local.set $t2 (i32.or (i32.and (i32.rotl (local.get $t2) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t2) (i32.const 24)) (i32.const -16711936))))
            (br_if $fd (i32.lt_u (local.get $t1) (local.get $t2)))
            (br_if $nf (i32.gt_u (local.get $t1) (local.get $t2)))
            (local.set $t1 (i32.load offset=332 (i32.const 0)))
            (local.set $t1 (i32.or (i32.and (i32.rotl (local.get $t1) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t1) (i32.const 24)) (i32.const -16711936))))
            (local.set $t2 (i32.load offset=364 (i32.const 0)))
            (local.set $t2 (i32.or (i32.and (i32.rotl (local.get $t2) (i32.const 8)) (i32.const 16711935)) (i32.and (i32.rotl (local.get $t2) (i32.const 24)) (i32.const -16711936))))
            (br_if $fd (i32.lt_u (local.get $t1) (local.get $t2)))
            (br_if $nf (i32.gt_u (local.get $t1) (local.get $t2)))
            (br $fd)
          )
          (i32.store offset=368 (i32.const 0) (local.get $n))
          (return (i32.const 1))
        )
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $next)
      )
    )
    (i32.const 0)
  )
)
